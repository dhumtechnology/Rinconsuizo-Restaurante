# Puerto de la aplicación web (Apache + PHP)
APP_PORT=8080

# Ruta base bajo el servidor web (dejar vacío en Docker / dominio raíz).
# En XAMPP (htdocs/resto) descomente esta línea:
# APP_BASE_PATH=/resto
# CSS correcto del POS: /resto/sistema/assets/css/style.css
# Incorrecto (404): /resto/{slug}/assets/...

# Puerto de MySQL expuesto al host (opcional)
DB_PORT=3306

# Puerto de phpMyAdmin
PHPMYADMIN_PORT=8081

# Credenciales MariaDB
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=rinconsuizo
MYSQL_USER=rinconsuizo
MYSQL_PASSWORD=rinconsuizo_secret

# Base de datos del módulo ecommerce/facturación (por defecto usa la misma)
MYSQL_DATABASE_ECOMMERCE=rinconsuizo

# Correo SMTP (verificación de cuenta, pedidos, etc.)
# Gmail: use contraseña de aplicación (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=contraseña_de_aplicacion
SMTP_FROM_EMAIL=tu_correo@gmail.com
SMTP_FROM_NAME=Rincon Suizo

# Impresoras térmicas de red (ESC/POS). El usuario las elige en el modal de impresión.
# Puerto típico: 9100. El PHP debe poder alcanzar esas IP (misma LAN).
# Agregue PRINTER_3_*, PRINTER_4_*, ... si hay más.
PRINTER_1_NAME=Caja
PRINTER_1_IP=192.168.1.50
PRINTER_1_PORT=9100

PRINTER_2_NAME=Cocina
PRINTER_2_IP=192.168.1.51
PRINTER_2_PORT=9100

# Alternativa en una sola línea (opcional, se suma a las de arriba):
# PRINTERS=Barra:192.168.1.52:9100
